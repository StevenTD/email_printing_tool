DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_TIME_ZONE=Asia/Manila
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
MAILPRINT_FERNET_KEY=generate-a-key-with-the-readme-command
MAILPRINT_LOGIN_FAILURE_LIMIT=5
MAILPRINT_LOGIN_COOLOFF_MINUTES=15
MAILPRINT_LOG_DIR=logs

# Leave empty to use SQLite. Example:
# DATABASE_URL=postgresql://mailprint:change-me@localhost:5432/mailprint
DATABASE_URL=

# Safety limits applied while fetching. Oversized attachments remain listed,
# but their content is not downloaded to disk.
MAILPRINT_MAX_EMAIL_BYTES=26214400
MAILPRINT_MAX_ATTACHMENT_BYTES=26214400
# Optional inclusive Gmail IMAP cutoff date (YYYY-MM-DD); blank fetches all unseen messages.
MAILPRINT_FETCH_SINCE_DATE=
MAILPRINT_DRY_RUN_DIR=
SUMATRA_PDF_PATH=SumatraPDF.exe
LIBREOFFICE_PATH=soffice

# For production over Tailscale Serve, use the device's exact tailnet DNS name:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,mailprint-host.example-tailnet.ts.net
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mailprint-host.example-tailnet.ts.net
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
